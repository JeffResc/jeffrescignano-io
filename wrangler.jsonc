{
  "name": "jeffrescignano-io",
  "compatibility_date": "2025-09-17",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "499bb37a5a054daa80f3ff835069a94b"
    }
  ],
  "routes": [
    {
      "pattern": "jeffrescignano.io",
      "custom_domain": true
    },
    {
      "pattern": "www.jeffrescignano.io",
      "custom_domain": true
    }
  ],
  "preview_urls": true
}
